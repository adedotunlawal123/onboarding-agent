    design of functions for handling database inputs
    ------------------------------------------------------------
    
   import sqlite3

# 1. The SINGLE generic function that handles the database work
def execute_query(query, params=()):
    with sqlite3.connect("my_database.db") as conn:
        cursor = conn.cursor()
        cursor.execute(query, params)
        conn.commit()

# 2. UNIQUE functions to handle the unique logic of each item
def insert_user(username, email):
    query = "INSERT INTO users (username, email) VALUES (?, ?)"
    execute_query(query, (username, email))

def insert_product(name, price):
    query = "INSERT INTO products (name, price) VALUES (?, ?)"
    execute_query(query, (name, price))
       
    
    



